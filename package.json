{
  "name": "securechat-desktop",
  "version": "0.5.0",
  "private": true,
  "description": "SecureChat desktop client with a bundled native renderer, verified portable updates and encrypted offline vault",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.cjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "setup:electron": "node node_modules/electron/install.js",
    "start": "npm run setup:electron && npm run build && electron .",
    "dist:win": "npm run setup:electron && npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "jp.hugohinoto.securechat.desktop",
    "productName": "SecureChat Desktop",
    "asar": true,
    "files": [
      "dist/src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "artifactName": "SecureChat-Desktop-${version}-portable.${ext}"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "19.0.1"
  }
}
